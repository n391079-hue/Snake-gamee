body {
    margin: 0;
    text-align: center;
    font-family: Arial, sans-serif;
    background: #222;
    color: white;
}

h1 {
    margin-top: 20px;
}

.score {
    font-size: 24px;
    margin: 10px;
}

canvas {
    background: #3fa34d;
    border: 5px solid white;
}

#gameOver {
    display: none;
    color: red;
}

button {
    padding: 10px 20px;
    font-size: 18px;
    cursor: pointer;
    margin-top: 10px;
}
