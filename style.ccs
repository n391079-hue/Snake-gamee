body {
    margin: 0;
    text-align: center;
    font-family: Arial, sans-serif;
    background: #101820;
    color: white;
}

h1 {
    margin-top: 15px;
    font-size: 32px;
}

.info {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin: 10px;
    font-size: 18px;
    font-weight: bold;
}

.info div {
    background: #1f2937;
    padding: 8px 12px;
    border-radius: 10px;
}

.settings {
    margin: 15px;
}

select {
    padding: 8px;
    margin: 5px;
    border-radius: 8px;
    font-size: 16px;
}

canvas {
    background: #3fa34d;
    border: 5px solid white;
    border-radius: 12px;
    max-width: 90vw;
    height: auto;
}

#gameOver {
    display: none;
    color: #ff4d4d;
}

button {
    padding: 10px 18px;
    margin-top: 10px;
    font-size: 17px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}

.controls {
    margin-top: 15px;
}

.controls button {
    width: 60px;
    height: 50px;
    margin: 4px;
    font-size: 24px;
    touch-action: manipulation;
}
